<script>
const DIFF_DATA = __DIFF_DATA_JSON__;
const BOX_W = 230, BOX_H = 46, OFF_X = 40, OFF_Y = 30, STEP_Y = 72;

let currentFilter = 'all';
const collapsedModules = new Set();

function esc(s){return (s+'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}

// Summary Metrics
const sb = DIFF_DATA.stats_before;
const sa = DIFF_DATA.stats_after;

document.getElementById('m-b-steps').textContent = sb.steps.toLocaleString();
document.getElementById('m-a-steps').textContent = sa.steps.toLocaleString();
const dSteps = sa.steps - sb.steps;
document.getElementById('m-d-steps').textContent = (dSteps >= 0 ? '+' : '') + dSteps.toLocaleString();
document.getElementById('m-d-steps').className = 'val ' + (dSteps > 0 ? 'delta-pos' : (dSteps < 0 ? 'delta-neg' : ''));

document.getElementById('m-b-db').textContent = sb.db_calls.toLocaleString();
document.getElementById('m-a-db').textContent = sa.db_calls.toLocaleString();
const dDB = sa.db_calls - sb.db_calls;
document.getElementById('m-d-db').textContent = (dDB >= 0 ? '+' : '') + dDB.toLocaleString();
document.getElementById('m-d-db').className = 'val ' + (dDB > 0 ? 'delta-pos' : (dDB < 0 ? 'delta-neg' : ''));

document.getElementById('m-b-mods').textContent = sb.modules.toLocaleString();
document.getElementById('m-a-mods').textContent = sa.modules.toLocaleString();
const dMods = sa.modules - sb.modules;
document.getElementById('m-d-mods').textContent = (dMods >= 0 ? '+' : '') + dMods.toLocaleString();
document.getElementById('m-d-mods').className = 'val ' + (dMods > 0 ? 'delta-pos' : (dMods < 0 ? 'delta-neg' : ''));

const diffsOnly = DIFF_DATA.diff_rows.filter(r => r.status !== 'MATCH').length;
document.getElementById('m-diff-count').textContent = `${diffsOnly} Steps Changed`;

function setFilter(f){
  currentFilter = f;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  const btn = document.getElementById('f-' + f);
  if(btn) btn.classList.add('active');
  renderDiagrams();
}

function toggleAllModules(collapse){
  DIFF_DATA.diff_rows.forEach(r => {
    ['before', 'after'].forEach(side => {
      const node = r[side];
      if(node && node.kind === 'module') {
        const key = `${side}_${node.key}`;
        if(collapse) collapsedModules.add(key);
        else collapsedModules.delete(key);
      }
    });
  });
  renderDiagrams();
}

function isRowVisible(r){
  if(currentFilter === 'diff') {
    return r.status !== 'MATCH';
  }
  if(currentFilter === 'db') {
    return (r.before && r.before.is_db) || (r.after && r.after.is_db);
  }
  if(currentFilter === 'para') {
    return (r.before && r.before.kind === 'step') || (r.after && r.after.kind === 'step');
  }
  if(currentFilter === 'module') {
    return (r.before && r.before.kind === 'module') || (r.after && r.after.kind === 'module');
  }
  return true;
}

function isNodeCollapsed(node, side){
  if(!node) return false;
  let pIdx = node.parent_idx;
  const nodes = (side === 'before') ? DIFF_DATA.diff_rows.map(r=>r.before).filter(Boolean) : DIFF_DATA.diff_rows.map(r=>r.after).filter(Boolean);
  while(pIdx !== null && pIdx !== undefined){
    const parent = nodes.find(n => n.idx === pIdx);
    if(parent){
      if(collapsedModules.has(`${side}_${parent.key}`)) return true;
      pIdx = parent.parent_idx;
    } else {
      break;
    }
  }
  return false;
}

function inspect(node, side){
  const el = document.getElementById('drawerBody');
  if(!node){ el.textContent = 'None'; return; }
  let msg = `[${side.toUpperCase()}] Line: ${node.first_line}\nType: ${node.kind.toUpperCase()}\nLabel: ${node.label}\nDepth: Lvl ${node.depth}\n`;
  if(node.is_db) msg += `Database Operation: YES\n`;
  if(node.messages && node.messages.length) {
    msg += `Log Statement: ${node.messages.map(m=>m[0]).join('\n')}\n`;
  }
  el.textContent = msg;
}

function buildBox(node, side, status, yPos){
  const box = document.createElement('div');
  let typeCls = 'is-para';
  let badge = '<span class="badge-tag badge-para">PARA</span>';

  if(node.is_db){
    typeCls = 'is-db';
    badge = '<span class="badge-tag badge-db">DB</span>';
  } else if(node.kind === 'module'){
    typeCls = 'is-module';
    badge = '<span class="badge-tag badge-call">CALL</span>';
  }

  let diffCls = '';
  if(status === 'ADDED') diffCls = 'diff-added';
  else if(status === 'REMOVED') diffCls = 'diff-removed';
  else if(status === 'MODIFIED') diffCls = 'diff-modified';

  box.className = `flowbox ${typeCls} ${diffCls}`;
  box.style.left = (node.x + OFF_X) + 'px';
  box.style.top = (yPos + OFF_Y) + 'px';
  box.style.width = BOX_W + 'px';
  box.style.height = BOX_H + 'px';

  let collapseIcon = '';
  if(node.kind === 'module'){
    const isCol = collapsedModules.has(`${side}_${node.key}`);
    collapseIcon = `<span style="font-size:10px;margin-right:4px;">${isCol ? '▸' : '▾'}</span>`;
  }

  box.innerHTML = `${badge}${collapseIcon}<span class="lbl">${esc(node.label)}</span>`;

  box.addEventListener('mouseenter', ()=> inspect(node, side));
  box.addEventListener('click', (e)=>{
    if(node.kind === 'module'){
      const key = `${side}_${node.key}`;
      if(collapsedModules.has(key)) collapsedModules.delete(key);
      else collapsedModules.add(key);
      renderDiagrams();
    } else {
      inspect(node, side);
    }
  });

  return box;
}

function renderDiagrams(){
  const cBefore = document.getElementById('canvasBefore');
  const cAfter = document.getElementById('canvasAfter');

  cBefore.querySelectorAll('.flowbox').forEach(b => b.remove());
  cAfter.querySelectorAll('.flowbox').forEach(b => b.remove());

  const rows = DIFF_DATA.diff_rows;
  let bNodes = [], aNodes = [];
  let renderedCount = 0;

  rows.forEach((r) => {
    if(!isRowVisible(r)) return;

    const bHide = isNodeCollapsed(r.before, 'before');
    const aHide = isNodeCollapsed(r.after, 'after');

    if((!r.before || bHide) && (!r.after || aHide)) return;

    const yPos = renderedCount * STEP_Y;

    if(r.before && !bHide){
      r.before._renderedY = yPos;
      cBefore.appendChild(buildBox(r.before, 'before', r.status, yPos));
      bNodes.push(r.before);
    }

    if(r.after && !aHide){
      r.after._renderedY = yPos;
      cAfter.appendChild(buildBox(r.after, 'after', r.status, yPos));
      aNodes.push(r.after);
    }

    renderedCount++;
  });

  const totalH = Math.max(renderedCount * STEP_Y + 120, 600);
  cBefore.style.width = DIFF_DATA.width_before + 'px';
  cBefore.style.height = totalH + 'px';
  cAfter.style.width = DIFF_DATA.width_after + 'px';
  cAfter.style.height = totalH + 'px';

  document.getElementById('title-b-count').textContent = `(${bNodes.length} visible)`;
  document.getElementById('title-a-count').textContent = `(${aNodes.length} visible)`;

  drawLines(bNodes, 'svgBefore', DIFF_DATA.width_before, totalH);
  drawLines(aNodes, 'svgAfter', DIFF_DATA.width_after, totalH);
}

function drawLines(nodes, svgId, width, totalH){
  const svg = document.getElementById(svgId);
  svg.innerHTML = '';
  svg.setAttribute('width', width);
  svg.setAttribute('height', totalH);
  const NS = 'http://www.w3.org/2000/svg';
  
  const defs = document.createElementNS(NS, 'defs');
  defs.innerHTML = `<marker id="arr-${svgId}" markerWidth="8" markerHeight="8" refX="5" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#5b7a63"/></marker>`;
  svg.appendChild(defs);

  for(let i=0; i<nodes.length-1; i++){
    const a = nodes[i];
    const b = nodes[i+1];
    const path = document.createElementNS(NS, 'path');
    
    const x1 = a.x + OFF_X + BOX_W/2;
    const y1 = a._renderedY + OFF_Y + BOX_H;
    const x2 = b.x + OFF_X + BOX_W/2;
    const y2 = b._renderedY + OFF_Y;

    let d = `M ${x1} ${y1} V ${(y1+y2)/2} H ${x2} V ${y2}`;
    path.setAttribute('d', d);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', '#5b7a63');
    path.setAttribute('stroke-width', '1.5');
    path.setAttribute('marker-end', `url(#arr-${svgId})`);
    svg.appendChild(path);
  }
}

// Initial Render
renderDiagrams();

// Synchronized Scrolling
const wB = document.getElementById('wrapBefore');
const wA = document.getElementById('wrapAfter');
let syncLock = false;

wB.addEventListener('scroll', ()=>{
  if(syncLock) return;
  syncLock = true;
  wA.scrollTop = wB.scrollTop;
  syncLock = false;
});

wA.addEventListener('scroll', ()=>{
  if(syncLock) return;
  syncLock = true;
  wB.scrollTop = wA.scrollTop;
  syncLock = false;
});
</script>
</body></html>
'''


def render_diff_html(diff_rows, stats_b, stats_a, out_path, w_b, w_a):
    data = {
        'diff_rows': diff_rows,
        'stats_before': stats_b,
        'stats_after': stats_a,
        'width_before': w_b,
        'width_after': w_a
    }
    payload = json.dumps(data, separators=(',', ':'))
    out = HTML_DIFF_TEMPLATE.replace('__DIFF_DATA_JSON__', payload)
    with open(out_path, 'w', encoding='utf-8') as f:
        f.write(out)


def compare_traces(path_before, path_after, out_path=None):
    """Core comparative function invoked by the CLI or GUI runner."""
    _, _, _, stats_b, graph_b = parse_stream(path_before, progress=False)
    _, _, _, stats_a, graph_a = parse_stream(path_after, progress=False)

    diff_rows, w_b, w_a = compute_comparative_diff(graph_b, graph_a)

    out_file = out_path or (path_after + '.comparison.html')
    render_diff_html(diff_rows, stats_b, stats_a, out_file, w_b, w_a)
    return out_file, stats_b, stats_a


def main():
    ap = argparse.ArgumentParser(description='TraceViz Comparative Differential Engine')
    ap.add_argument('input', help='Before log or primary trace log')
    ap.add_argument('--after', help='After change trace log for differential evaluation', default=None)

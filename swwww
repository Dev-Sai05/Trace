#!/usr/bin/env python3
"""
traceviz_app.py - AI Code Automation Flow Visualizer.

Run with:
    python3 traceviz_app.py

Requires: Python 3 with standard tkinter.
"""

import math
import os
import queue
import random
import sys
import threading
import time
import tkinter as tk
import webbrowser
from tkinter import filedialog, messagebox
from tkinter import ttk

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import traceviz as tv

# Matrix / Terminal Green AI Palette
BG = '#050805'
PANEL = '#09120a'
PANEL2 = '#0d1a0f'
LINE = '#132817'
LINE_BRIGHT = '#1e3d24'
GREEN = '#00ff66'
GREEN_DIM = '#5cd685'
GREEN_MUTED = '#235930'
GREEN_DARK = '#0b2412'
AMBER = '#ffb84d'
RED = '#ff4d6d'
GRAY = '#4a6350'
TEXT = '#d2f0da'

MONO = ('Consolas', 10) if sys.platform.startswith('win') else ('Menlo', 10) if sys.platform == 'darwin' else ('DejaVu Sans Mono', 9)
SANS = ('Segoe UI', 9) if sys.platform.startswith('win') else ('SF Pro Display', 9) if sys.platform == 'darwin' else ('DejaVu Sans', 9)

# Minimum visual showcase duration (seconds) so quick parses are still watchable
MIN_VISUAL_TIME = 2.8


class TraceVizApp:
    def __init__(self, root):
        self.root = root
        self.root.title('TRACEVIEW AI // Automated Code & Execution Flow Visualizer')
        self.root.geometry('980x740')
        self.root.minsize(900, 660)
        self.root.configure(bg=BG)

        self.msg_queue = queue.Queue()
        self.worker = None
        self.result = None

        # Automation visualizer state
        self.is_running = False
        self.anim_tick = 0
        self.stream_lines = []
        self.code_tokens = [
            'CALL SUB_EXEC()', 'PARM_RESOLVE', 'STACK_PUSH[0x4F]', 'LOOP_COLLAPSE',
            'JMP_NZ 0x0041', 'HEAP_ALLOC', 'RESOLVE_PTR', 'EVAL_BRANCH',
            'RECURSION_GUARD', 'REG_STORE R1', 'SCAN_TOKEN', 'UNWIND_FRAME'
        ]
        
        # Branch tree nodes for the visualizer
        self.tree_nodes = [
            {'x': 0.15, 'y': 0.50, 'label': 'ROOT'},
            {'x': 0.32, 'y': 0.28, 'label': 'EXEC'},
            {'x': 0.32, 'y': 0.72, 'label': 'FLOW'},
            {'x': 0.50, 'y': 0.18, 'label': 'CALL'},
            {'x': 0.50, 'y': 0.42, 'label': 'LOOP'},
            {'x': 0.50, 'y': 0.68, 'label': 'COND'},
            {'x': 0.68, 'y': 0.35, 'label': 'EVAL'},
            {'x': 0.68, 'y': 0.82, 'label': 'RETURN'}
        ]
        self.tree_edges = [
            (0, 1), (0, 2), (1, 3), (1, 4), (2, 5), (4, 6), (5, 7)
        ]

        self._build_style()
        self._build_layout()
        self.root.after(100, self._poll_queue)
        self._animate_automation_canvas()

    def _build_style(self):
        style = ttk.Style()
        try:
            style.theme_use('clam')
        except tk.TclError:
            pass
        style.configure('Green.Horizontal.TProgressbar',
                        troughcolor=PANEL2,
                        background=GREEN,
                        bordercolor=LINE,
                        lightcolor=GREEN,
                        darkcolor=GREEN_MUTED)

    def _label(self, parent, text, **kw):
        return tk.Label(parent, text=text, bg=kw.pop('bg', BG), fg=kw.pop('fg', TEXT),
                        font=kw.pop('font', MONO), anchor='w', **kw)

    def _button(self, parent, text, cmd, **kw):
        return tk.Button(parent, text=text, command=cmd, bg=PANEL2, fg=GREEN,
                         activebackground=LINE_BRIGHT, activeforeground=GREEN,
                         font=(MONO[0], 9, 'bold'), relief='flat', padx=12, pady=6,
                         cursor='hand2', highlightbackground=LINE, highlightthickness=1, **kw)

    def _build_layout(self):
        # Header bar
        header = tk.Frame(self.root, bg=BG)
        header.pack(fill='x', padx=20, pady=(14, 6))

        title_box = tk.Frame(header, bg=BG)
        title_box.pack(side='left')

        tk.Label(title_box, text='TRACEVIEW', bg=BG, fg=GREEN,
                 font=(MONO[0], 16, 'bold')).pack(side='left')
        tk.Label(title_box, text=' [AI AUTOMATION ENGINE] ', bg=BG, fg=GREEN_DIM,
                 font=(MONO[0], 10, 'bold')).pack(side='left')
        tk.Label(title_box, text='// real-time code stream synthesizer',
                 bg=BG, fg=GRAY, font=MONO).pack(side='left')

        # Designed by TCS Branding
        brand_badge = tk.Frame(header, bg=PANEL2, highlightbackground=LINE_BRIGHT, highlightthickness=1)
        brand_badge.pack(side='right')
        tk.Label(brand_badge, text='Designed by TCS', bg=PANEL2, fg=GREEN,
                 font=(SANS[0], 9, 'bold'), padx=10, pady=4).pack()

        # File picker
        picker = tk.Frame(self.root, bg=BG)
        picker.pack(fill='x', padx=20, pady=(6, 6))
        self._label(picker, 'Target Log:').pack(side='left')

        self.path_var = tk.StringVar()
        entry = tk.Entry(picker, textvariable=self.path_var, bg=PANEL2, fg=TEXT,
                         insertbackground=GREEN, font=MONO, relief='flat',
                         highlightbackground=LINE, highlightthickness=1)
        entry.pack(side='left', fill='x', expand=True, padx=8, ipady=5)
        self._button(picker, 'Browse…', self._browse).pack(side='left', padx=(0, 4))

        # Controls & trigger
        opts = tk.Frame(self.root, bg=BG)
        opts.pack(fill='x', padx=20, pady=(2, 6))
        self.stats_only_var = tk.BooleanVar(value=False)
        cb = tk.Checkbutton(opts, text='Telemetry Scan Only (bypass HTML generation)',
                            variable=self.stats_only_var, bg=BG, fg=TEXT,
                            selectcolor=PANEL2, activebackground=BG, activeforeground=TEXT,
                            font=MONO)
        cb.pack(side='left')

        self.run_btn = self._button(opts, '▶ EXECUTE AI PIPELINE', self._start_run)
        self.run_btn.pack(side='right')

        # AI Execution & Automation Canvas
        ai_shell = tk.Frame(self.root, bg=PANEL, highlightbackground=LINE_BRIGHT, highlightthickness=1)
        ai_shell.pack(fill='x', padx=20, pady=(4, 6))

        top_info = tk.Frame(ai_shell, bg=PANEL)
        top_info.pack(fill='x', padx=10, pady=(6, 2))

        self.pipeline_status = self._label(top_info, '● SYSTEM IDLE — AWAITING TRACE INGESTION',
                                          bg=PANEL, fg=GRAY, font=(MONO[0], 9, 'bold'))
        self.pipeline_status.pack(side='left')

        self.telemetry_metrics = self._label(top_info, 'INSTRUCTION GRAPH: DORMANT',
                                            bg=PANEL, fg=GRAY, font=(MONO[0], 9))
        self.telemetry_metrics.pack(side='right')

        self.canvas = tk.Canvas(ai_shell, bg='#030603', height=95, highlightthickness=0)
        self.canvas.pack(fill='x', padx=8, pady=(2, 8))

        # Progress bar
        prog = tk.Frame(self.root, bg=BG)
        prog.pack(fill='x', padx=20, pady=(0, 6))
        self.progressbar = ttk.Progressbar(prog, style='Green.Horizontal.TProgressbar',
                                           mode='determinate', maximum=100)
        self.progressbar.pack(fill='x')
        self.progress_label = self._label(prog, 'Engine ready.', fg=GRAY)
        self.progress_label.pack(fill='x', pady=(4, 0))

        # Console
        console_frame = tk.Frame(self.root, bg=PANEL, highlightbackground=LINE, highlightthickness=1)
        console_frame.pack(fill='both', expand=True, padx=20, pady=(0, 8))
        self.console = tk.Text(console_frame, bg='#040704', fg=GREEN_DIM, insertbackground=GREEN,
                               font=MONO, relief='flat', wrap='word', height=10)
        self.console.pack(fill='both', expand=True, padx=6, pady=6)
        self.console.configure(state='disabled')

        # Footer Actions
        self.summary_frame = tk.Frame(self.root, bg=PANEL, highlightbackground=LINE, highlightthickness=1)
        self.summary_frame.pack(fill='x', padx=20, pady=(0, 14))

        self.summary_label = self._label(self.summary_frame, '', bg=PANEL, fg=TEXT)
        self.summary_label.pack(side='left', padx=12, pady=8)

        self.open_report_btn = self._button(self.summary_frame, 'Launch Interactive Report',
                                            self._open_report, state='disabled')
        self.open_report_btn.pack(side='right', padx=6, pady=6)

        self.open_errors_btn = self._button(self.summary_frame, 'View Anomaly Log',
                                            self._open_errors, state='disabled')
        self.open_errors_btn.pack(side='right', padx=6, pady=6)

    def _browse(self):
        path = filedialog.askopenfilename(title='Select trace log file',
                                          filetypes=[('Log/trace/text', '*.log *.trc *.txt'), ('All files', '*.*')])
        if path:
            self.path_var.set(path)

    def _log(self, text):
        self.console.configure(state='normal')
        self.console.insert('end', text + '\n')
        self.console.see('end')
        self.console.configure(state='disabled')

    def _animate_automation_canvas(self):
        self.canvas.delete('all')
        w = self.canvas.winfo_width()
        h = self.canvas.winfo_height()

        if w > 10:
            if self.is_running:
                # 1. Left side: Paced scrolling machine code & assembly disassembler
                split_x = int(w * 0.70)
                self.canvas.create_line(split_x, 6, split_x, h - 6, fill=LINE_BRIGHT, width=1)

                # Push instruction stream tokens every 6 ticks
                if self.anim_tick % 6 == 0:
                    hex_addr = f'0x{random.randint(0x1000, 0xFFFF):04X}'
                    tok = random.choice(self.code_tokens)
                    op_hex = f'{random.randint(0,255):02X} {random.randint(0,255):02X}'
                    self.stream_lines.append(f'{hex_addr}  [{op_hex}]  {tok}')
                    if len(self.stream_lines) > 5:
                        self.stream_lines.pop(0)

                # Render stream lines with smooth stepped brightness
                for idx, line_text in enumerate(self.stream_lines):
                    y = 16 + (idx * 16)
                    intensity = int(70 + (idx / max(len(self.stream_lines), 1)) * 185)
                    color = f'#00{intensity:02x}44' if idx < len(self.stream_lines)-1 else GREEN
                    self.canvas.create_text(14, y, anchor='w', text=line_text,
                                            fill=color, font=(MONO[0], 8))

                # 2. Right side: AST Execution Tree & Flow Pulses
                tree_w = w - split_x
                t_base_x = split_x

                # Render connecting branch wires
                for u, v in self.tree_edges:
                    x1 = t_base_x + int(self.tree_nodes[u]['x'] * tree_w)
                    y1 = int(self.tree_nodes[u]['y'] * h)
                    x2 = t_base_x + int(self.tree_nodes[v]['x'] * tree_w)
                    y2 = int(self.tree_nodes[v]['y'] * h)
                    self.canvas.create_line(x1, y1, x2, y2, fill=GREEN_MUTED, width=1)

                    # Smooth packet traveling across branches
                    pkt_progress = (self.anim_tick * 0.025 + (u + v) * 0.25) % 1.0
                    px = x1 + (x2 - x1) * pkt_progress
                    py = y1 + (y2 - y1) * pkt_progress
                    self.canvas.create_oval(px - 2.5, py - 2.5, px + 2.5, py + 2.5, fill=GREEN, outline='')

                # Render AST execution nodes
                for i, node in enumerate(self.tree_nodes):
                    nx = t_base_x + int(node['x'] * tree_w)
                    ny = int(node['y'] * h)
                    pulse = math.sin(self.anim_tick * 0.10 + i)
                    rad = 3 + int(pulse * 1.5)
                    
                    self.canvas.create_oval(nx - rad, ny - rad, nx + rad, ny + rad,
                                            fill=GREEN if pulse > 0.3 else GREEN_MUTED, outline='')
                    self.canvas.create_text(nx, ny - 8, text=node['label'],
                                            fill=GREEN_DIM if pulse > 0.3 else GRAY,
                                            font=(MONO[0], 7))

                # 3. Controlled speed radar beam sweep
                sweep_x = (self.anim_tick * 3) % w
                self.canvas.create_line(sweep_x, 0, sweep_x, h, fill=LINE_BRIGHT, width=1)

                self.anim_tick += 1
            else:
                # Idle state
                self.canvas.create_line(0, h / 2, w, h / 2, fill=GREEN_DARK, width=1, dash=(4, 6))
                self.canvas.create_text(w / 2, h / 2, text='[ CODE AUTOMATION PIPELINE READY ]',
                                        fill=GREEN_MUTED, font=(MONO[0], 9, 'bold'))

        self.root.after(55, self._animate_automation_canvas)

    def _start_run(self):
        path = self.path_var.get().strip()
        if not path:
            messagebox.showwarning('No file selected', 'Choose a trace log file first.')
            return
        if not os.path.isfile(path):
            messagebox.showerror('File not found', f'Could not find:\n{path}')
            return
        if self.worker and self.worker.is_alive():
            return

        self.is_running = True
        self.stream_lines.clear()
        self.console.configure(state='normal')
        self.console.delete('1.0', 'end')
        self.console.configure(state='disabled')
        self.open_report_btn.configure(state='disabled')
        self.open_errors_btn.configure(state='disabled')
        self.summary_label.configure(text='')
        self.run_btn.configure(state='disabled', text='AUTOMATION RUNNING...')
        self.progressbar['value'] = 0
        self.progress_label.configure(text='Initializing stream parser engines...', fg=GREEN_DIM)

        self.pipeline_status.configure(text='● AI AGENT ACTIVE — PARSING & REDUCING FLOW', fg=GREEN)
        self.telemetry_metrics.configure(text='SYNAPSE: LIVE STREAMING', fg=GREEN_DIM)

        self._log('[AI AGENT] Stream disassembly engine engaged.')
        self._log(f'[TARGET LOG] {path}')

        stats_only = self.stats_only_var.get()
        self.worker = threading.Thread(target=self._worker_run, args=(path, stats_only), daemon=True)
        self.worker.start()

    def _worker_run(self, path, stats_only):
        t0 = time.time()

        def progress_cb(line_no, pct, elapsed, stats):
            self.msg_queue.put(('progress', line_no, pct, elapsed, dict(stats)))

        try:
            root, header, error_index, stats, graph_json = tv.parse_stream(path, progress=progress_cb)
            out_html = out_err = None
            if not stats_only:
                tv.cap_children(root, tv.DEFAULT_MAX_CHILDREN)
                out_html = path + '.report.html'
                out_err = path + '.errors.txt'
                tv.render_html(root, header, error_index, stats, graph_json, out_html)
                tv.write_error_file(error_index, out_err)

            elapsed_work = time.time() - t0
            if elapsed_work < MIN_VISUAL_TIME:
                time.sleep(MIN_VISUAL_TIME - elapsed_work)

            self.msg_queue.put(('done', header, stats, out_html, out_err, time.time() - t0))
        except Exception as e:
            self.msg_queue.put(('error', str(e)))

    def _poll_queue(self):
        try:
            while True:
                item = self.msg_queue.get_nowait()
                kind = item[0]
                if kind == 'progress':
                    _, line_no, pct, elapsed, stats = item
                    self.progressbar['value'] = pct if pct else 0
                    self.progress_label.configure(
                        text=f'{line_no:,} instructions ingested  •  {elapsed:.1f}s elapsed  •  '
                             f'{stats.get("loops", 0):,} loops collapsed  •  {stats.get("errors", 0):,} errors',
                        fg=TEXT)
                    self.telemetry_metrics.configure(
                        text=f'INGESTION: {pct:.1f}% | ANOMALIES: {stats.get("errors", 0)}',
                        fg=GREEN)
                    self._log(f'  [TRACE] {line_no:,} lines ({pct:.1f}%) | '
                              f'anomalies: {stats.get("errors", 0)} | collapsed loops: {stats.get("loops", 0)}')
                elif kind == 'done':
                    self.is_running = False
                    self.pipeline_status.configure(text='✓ FLOW REDUCTION & SYNTHESIS COMPLETE', fg=GREEN)
                    self.telemetry_metrics.configure(text='STATE: RESOLVED', fg=GRAY)
                    _, header, stats, out_html, out_err, total_time = item
                    self.progressbar['value'] = 100
                    self.run_btn.configure(state='normal', text='▶ EXECUTE AI PIPELINE')
                    rc = header.get('rc')
                    rc_bad = rc is not None and str(rc).strip().lstrip('-').isdigit() and int(rc) != 0

                    lines_str = f"{stats['lines']:,} lines"
                    errors_str = f"{stats['errors']:,} errors"
                    loops_str = f"{stats['loops']:,} loops saved"
                    time_str = f"{stats['elapsed']:.2f} seconds"
                    rc_str = str(rc) + (" (CRITICAL)" if rc_bad else " (NORMAL)")

                    self._log('')
                    self._log('┌──────────────── AI FLOW EXECUTION SUMMARY ────────────────┐')
                    self._log(f'│ Program          : {header.get("program", ""):<39}│')
                    self._log(f'│ Return Code (RC) : {rc_str:<39}│')
                    self._log(f'│ Processed Lines  : {lines_str:<39}│')
                    self._log(f'│ Isolated Errors  : {errors_str:<39}│')
                    self._log(f'│ Collapsed Loops  : {loops_str:<39}│')
                    self._log(f'│ Execution Time   : {time_str:<39}│')
                    self._log('└───────────────────────────────────────────────────────────┘')
                    self._log('[STATUS] Reports synthesized successfully.')

                    summary = (f'RC={rc}   errors={stats["errors"]}   '
                               f'collapsed loops={stats["loops"]:,}   time={stats["elapsed"]:.1f}s')
                    self.summary_label.configure(text=summary, fg=(RED if rc_bad or stats['errors'] else GREEN))
                    self.result = (out_html, out_err)
                    if out_html:
                        self.open_report_btn.configure(state='normal')
                    if out_err:
                        self.open_errors_btn.configure(state='normal')
                elif kind == 'error':
                    self.is_running = False
                    _, msg = item
                    self.pipeline_status.configure(text='✕ PIPELINE ABORTED', fg=RED)
                    self.run_btn.configure(state='normal', text='▶ EXECUTE AI PIPELINE')
                    self._log(f'[FATAL ERROR] {msg}')
                    messagebox.showerror('Parsing Error', msg)
        except queue.Empty:
            pass
        self.root.after(100, self._poll_queue)

    def _open_report(self):
        if self.result and self.result[0]:
            webbrowser.open('file://' + os.path.abspath(self.result[0]))

    def _open_errors(self):
        if self.result and self.result[1]:
            path = os.path.abspath(self.result[1])
            try:
                if sys.platform.startswith('win'):
                    os.startfile(path)
                elif sys.platform == 'darwin':
                    os.system(f'open "{path}"')
                else:
                    os.system(f'xdg-open "{path}"')
            except Exception:
                webbrowser.open('file://' + path)


def main():
    root = tk.Tk()
    app = TraceVizApp(root)
    root.mainloop()


if __name__ == '__main__':
    main()

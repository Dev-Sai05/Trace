#!/usr/bin/env python3
"""
traceviz_app.py - AI-Enhanced Desktop GUI for Trace Log Flow Visualizer.

Run with:
    python3 traceviz_app.py

Requires: Python 3 with standard tkinter.
"""

import math
import os
import queue
import random
import sys
import threading
import time
import tkinter as tk
import webbrowser
from tkinter import filedialog, messagebox
from tkinter import ttk

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import traceviz as tv

# High-Contrast Terminal Green AI Palette
BG = '#040704'
PANEL = '#09120a'
PANEL2 = '#0d1a0f'
LINE = '#132817'
GREEN = '#00ff66'
GREEN_DIM = '#5cd685'
GREEN_MUTED = '#1e4a27'
GREEN_DARK = '#07150a'
AMBER = '#ffb84d'
RED = '#ff4d6d'
GRAY = '#4a6350'
TEXT = '#d2f0da'

MONO = ('Consolas', 10) if sys.platform.startswith('win') else ('Menlo', 10) if sys.platform == 'darwin' else ('DejaVu Sans Mono', 9)
SANS = ('Segoe UI', 10) if sys.platform.startswith('win') else ('SF Pro Display', 10) if sys.platform == 'darwin' else ('DejaVu Sans', 9)

# Minimum visual runtime (seconds) to prevent animations vanishing instantly on small traces
MIN_VISUAL_TIME = 2.4


class TraceVizApp:
    def __init__(self, root):
        self.root = root
        self.root.title('TRACEVIEW AI // Mainframe Cognitive Flow Visualizer')
        self.root.geometry('960x740')
        self.root.minsize(880, 660)
        self.root.configure(bg=BG)

        self.msg_queue = queue.Queue()
        self.worker = None
        self.result = None

        # Automation & AI animation state
        self.is_running = False
        self.anim_tick = 0
        self.ai_phase_idx = 0
        self.ai_phases = [
            'SYNAPSE INITIALIZATION...',
            'INGESTING TRACE BYTE STREAM...',
            'RECURSIVE GRAPH TRAVERSAL...',
            'HEURISTIC LOOP COLLAPSE...',
            'ANOMALY & ERROR ISOLATION...',
            'SYNTHESIZING FLOW REPORT...'
        ]

        # Background matrix rain state for the console panel
        self.matrix_drops = []
        self.matrix_chars = '01010110ABCDEF<>[]{}/*+$~=#'

        self._build_style()
        self._build_layout()
        self.root.after(100, self._poll_queue)
        self._animate_ai_canvas()

    def _build_style(self):
        style = ttk.Style()
        try:
            style.theme_use('clam')
        except tk.TclError:
            pass
        style.configure('AI.Horizontal.TProgressbar',
                        troughcolor=PANEL2,
                        background=GREEN,
                        bordercolor=LINE,
                        lightcolor=GREEN,
                        darkcolor=GREEN_MUTED)

    def _label(self, parent, text, **kw):
        return tk.Label(parent, text=text, bg=kw.pop('bg', BG), fg=kw.pop('fg', TEXT),
                        font=kw.pop('font', MONO), anchor='w', **kw)

    def _button(self, parent, text, cmd, **kw):
        return tk.Button(parent, text=text, command=cmd, bg=PANEL2, fg=GREEN,
                         activebackground=LINE, activeforeground=GREEN,
                         font=(MONO[0], 9, 'bold'), relief='flat', padx=12, pady=6,
                         cursor='hand2', highlightbackground=LINE, highlightthickness=1, **kw)

    def _build_layout(self):
        # Top Header Bar
        header = tk.Frame(self.root, bg=BG)
        header.pack(fill='x', padx=20, pady=(14, 4))

        title_box = tk.Frame(header, bg=BG)
        title_box.pack(side='left')

        tk.Label(title_box, text='TRACEVIEW', bg=BG, fg=GREEN,
                 font=(MONO[0], 16, 'bold')).pack(side='left')
        tk.Label(title_box, text=' [AI ENGINE] ', bg=BG, fg=GREEN_DIM,
                 font=(MONO[0], 10, 'bold')).pack(side='left')
        tk.Label(title_box, text='// cognitive streaming flow visualizer',
                 bg=BG, fg=GRAY, font=MONO).pack(side='left')

        # Branding: Designed by TCS
        brand_badge = tk.Frame(header, bg=PANEL2, highlightbackground=LINE, highlightthickness=1)
        brand_badge.pack(side='right')
        tk.Label(brand_badge, text='Designed by TCS', bg=PANEL2, fg=GREEN,
                 font=(SANS[0], 9, 'bold'), padx=10, pady=4).pack()

        # File Picker Row
        picker = tk.Frame(self.root, bg=BG)
        picker.pack(fill='x', padx=20, pady=(10, 6))
        self._label(picker, 'Target Trace:').pack(side='left')

        self.path_var = tk.StringVar()
        entry = tk.Entry(picker, textvariable=self.path_var, bg=PANEL2, fg=TEXT,
                         insertbackground=GREEN, font=MONO, relief='flat',
                         highlightbackground=LINE, highlightthickness=1)
        entry.pack(side='left', fill='x', expand=True, padx=8, ipady=5)
        self._button(picker, 'Browse…', self._browse).pack(side='left', padx=(0, 4))

        # Options & Trigger
        opts = tk.Frame(self.root, bg=BG)
        opts.pack(fill='x', padx=20, pady=(2, 8))
        self.stats_only_var = tk.BooleanVar(value=False)
        cb = tk.Checkbutton(opts, text='Quick Scan (Telemetry Only, skip HTML generation)',
                            variable=self.stats_only_var, bg=BG, fg=TEXT,
                            selectcolor=PANEL2, activebackground=BG, activeforeground=TEXT,
                            font=MONO)
        cb.pack(side='left')

        self.run_btn = self._button(opts, '⚡ EXECUTE AI AGENT', self._start_run)
        self.run_btn.pack(side='right')

        # AI Automation Canvas (Visualizer)
        self.ai_frame = tk.Frame(self.root, bg=PANEL, highlightbackground=LINE, highlightthickness=1)
        self.ai_frame.pack(fill='x', padx=20, pady=(0, 8))

        top_info = tk.Frame(self.ai_frame, bg=PANEL)
        top_info.pack(fill='x', padx=10, pady=(6, 2))

        self.phase_label = self._label(top_info, '● SYSTEM STANDBY: Awaiting execution',
                                       bg=PANEL, fg=GRAY, font=(MONO[0], 9, 'bold'))
        self.phase_label.pack(side='left')

        self.nodes_label = self._label(top_info, 'NODES ACTIVE: 0 | STREAM: IDLE',
                                       bg=PANEL, fg=GRAY, font=(MONO[0], 9))
        self.nodes_label.pack(side='right')

        self.canvas = tk.Canvas(self.ai_frame, bg='#020502', height=76, highlightthickness=0)
        self.canvas.pack(fill='x', padx=8, pady=(2, 8))

        # Progress bar
        prog = tk.Frame(self.root, bg=BG)
        prog.pack(fill='x', padx=20, pady=(0, 8))
        self.progressbar = ttk.Progressbar(prog, style='AI.Horizontal.TProgressbar',
                                           mode='determinate', maximum=100)
        self.progressbar.pack(fill='x')
        self.progress_label = self._label(prog, 'Idle.', fg=GRAY)
        self.progress_label.pack(fill='x', pady=(4, 0))

        # Terminal / AI Matrix Console Frame with Animated Canvas Backdrop
        console_frame = tk.Frame(self.root, bg=PANEL, highlightbackground=LINE, highlightthickness=1)
        console_frame.pack(fill='both', expand=True, padx=20, pady=(0, 8))

        self.matrix_canvas = tk.Canvas(console_frame, bg='#030703', highlightthickness=0)
        self.matrix_canvas.pack(fill='both', expand=True)

        # Transparent terminal overlay layered over the animated canvas
        self.console = tk.Text(self.matrix_canvas, bg='#030703', fg=GREEN_DIM,
                               insertbackground=GREEN, font=MONO, relief='flat',
                               wrap='word', height=10)
        self.console_win = self.matrix_canvas.create_window(6, 6, anchor='nw', window=self.console)
        self.matrix_canvas.bind('<Configure>', self._on_console_resize)
        self.console.configure(state='disabled')

        # Summary & Actions
        self.summary_frame = tk.Frame(self.root, bg=PANEL, highlightbackground=LINE, highlightthickness=1)
        self.summary_frame.pack(fill='x', padx=20, pady=(0, 14))

        self.summary_label = self._label(self.summary_frame, '', bg=PANEL, fg=TEXT)
        self.summary_label.pack(side='left', padx=12, pady=8)

        self.open_report_btn = self._button(self.summary_frame, 'Launch Interactive Report',
                                            self._open_report, state='disabled')
        self.open_report_btn.pack(side='right', padx=6, pady=6)

        self.open_errors_btn = self._button(self.summary_frame, 'Inspect Anomalies',
                                            self._open_errors, state='disabled')
        self.open_errors_btn.pack(side='right', padx=6, pady=6)

    def _on_console_resize(self, event):
        w = max(10, event.width - 12)
        h = max(10, event.height - 12)
        self.matrix_canvas.coords(self.console_win, 6, 6)
        self.matrix_canvas.itemconfigure(self.console_win, width=w, height=h)

    def _browse(self):
        path = filedialog.askopenfilename(title='Select trace log file',
                                          filetypes=[('Log/trace/text', '*.log *.trc *.txt'), ('All files', '*.*')])
        if path:
            self.path_var.set(path)

    def _log(self, text):
        self.console.configure(state='normal')
        self.console.insert('end', text + '\n')
        self.console.see('end')
        self.console.configure(state='disabled')

    def _animate_ai_canvas(self):
        # 1. Top Wave & Neural Telemetry Canvas
        self.canvas.delete('all')
        w = self.canvas.winfo_width()
        h = self.canvas.winfo_height()

        if w > 1:
            if self.is_running:
                # Vertical scanning line
                scan_x = (self.anim_tick * 4) % w
                self.canvas.create_line(scan_x, 0, scan_x, h, fill=GREEN_MUTED, width=1)

                # Telemetry wave
                points = []
                for x in range(0, w, 6):
                    freq = 0.035
                    y = (h / 2) + math.sin(x * freq + self.anim_tick * 0.09) * 18 * \
                        math.cos((x + self.anim_tick) * 0.012)
                    points.extend([x, y])
                if len(points) >= 4:
                    self.canvas.create_line(points, fill=GREEN, width=2, smooth=True)

                # Floating neural node pulses
                random.seed(42)
                for i in range(12):
                    nx = (i * (w / 12) + math.sin(self.anim_tick * 0.06 + i) * 16) % w
                    ny = 15 + ((i * 23 + self.anim_tick * 2) % (h - 30))
                    rad = 3 + math.sin(self.anim_tick * 0.15 + i) * 2
                    self.canvas.create_oval(nx - rad, ny - rad, nx + rad, ny + rad,
                                            fill=GREEN if i % 3 == 0 else GREEN_DIM, outline='')
                    if i > 0:
                        prev_x = ((i - 1) * (w / 12) + math.sin(self.anim_tick * 0.06 + (i - 1)) * 16) % w
                        self.canvas.create_line(nx, ny, prev_x, h / 2, fill=GREEN_DARK, width=1)

                # Update live telemetry indicators
                if self.anim_tick % 16 == 0:
                    self.ai_phase_idx = (self.ai_phase_idx + 1) % len(self.ai_phases)
                    self.phase_label.configure(
                        text=f'⚡ AI PIPELINE ACTIVE: {self.ai_phases[self.ai_phase_idx]}',
                        fg=GREEN)
                    self.nodes_label.configure(
                        text=f'NEURAL NODES: 64 ACTIVE | ENTROPY: {random.uniform(0.12, 0.44):.3f}',
                        fg=GREEN_DIM)
            else:
                self.canvas.create_line(0, h / 2, w, h / 2, fill=GREEN_DARK, width=1, dash=(4, 6))
                self.canvas.create_text(w / 2, h / 2, text='AI STREAM ANALYZER STANDBY',
                                        fill=GREEN_MUTED, font=(MONO[0], 9, 'bold'))

        # 2. Lower Console Matrix Rain Animation
        mw = self.matrix_canvas.winfo_width()
        mh = self.matrix_canvas.winfo_height()
        if mw > 20 and mh > 20:
            cols = max(1, mw // 22)
            while len(self.matrix_drops) < cols:
                self.matrix_drops.append(random.randint(-20, mh))

            self.matrix_canvas.delete('matrix_stream')
            if self.is_running:
                for i in range(cols):
                    x = i * 22 + 10
                    y = self.matrix_drops[i]
                    char = random.choice(self.matrix_chars)

                    # Matrix streaming trace
                    self.matrix_canvas.create_text(x, y, text=char, fill=GREEN,
                                                   font=(MONO[0], 8), tags='matrix_stream')
                    for trail_idx in range(1, 4):
                        trail_y = y - (trail_idx * 14)
                        if trail_y > 0:
                            self.matrix_canvas.create_text(x, trail_y,
                                                           text=random.choice(self.matrix_chars),
                                                           fill=GREEN_MUTED, font=(MONO[0], 7),
                                                           tags='matrix_stream')

                    self.matrix_drops[i] += 6
                    if self.matrix_drops[i] > mh:
                        self.matrix_drops[i] = random.randint(-40, 0)

        self.anim_tick += 1
        self.root.after(50, self._animate_ai_canvas)

    def _start_run(self):
        path = self.path_var.get().strip()
        if not path:
            messagebox.showwarning('No file selected', 'Choose a trace log file first.')
            return
        if not os.path.isfile(path):
            messagebox.showerror('File not found', f'Could not find:\n{path}')
            return
        if self.worker and self.worker.is_alive():
            return

        self.is_running = True
        self.console.configure(state='normal')
        self.console.delete('1.0', 'end')
        self.console.configure(state='disabled')
        self.open_report_btn.configure(state='disabled')
        self.open_errors_btn.configure(state='disabled')
        self.summary_label.configure(text='')
        self.run_btn.configure(state='disabled', text='PROCESSING...')
        self.progressbar['value'] = 0
        self.progress_label.configure(text='Spinning up parsing engines...', fg=GREEN)

        self._log('[AI INIT] Autonomous stream parsing triggered...')
        self._log(f'[AI TARGET] {path}')

        stats_only = self.stats_only_var.get()
        self.worker = threading.Thread(target=self._worker_run, args=(path, stats_only), daemon=True)
        self.worker.start()

    def _worker_run(self, path, stats_only):
        t0 = time.time()

        def progress_cb(line_no, pct, elapsed, stats):
            self.msg_queue.put(('progress', line_no, pct, elapsed, dict(stats)))

        try:
            root, header, error_index, stats, graph_json = tv.parse_stream(path, progress=progress_cb)
            out_html = out_err = None
            if not stats_only:
                tv.cap_children(root, tv.DEFAULT_MAX_CHILDREN)
                out_html = path + '.report.html'
                out_err = path + '.errors.txt'
                tv.render_html(root, header, error_index, stats, graph_json, out_html)
                tv.write_error_file(error_index, out_err)

            elapsed_work = time.time() - t0
            if elapsed_work < MIN_VISUAL_TIME:
                time.sleep(MIN_VISUAL_TIME - elapsed_work)

            self.msg_queue.put(('done', header, stats, out_html, out_err, time.time() - t0))
        except Exception as e:
            self.msg_queue.put(('error', str(e)))

    def _poll_queue(self):
        try:
            while True:
                item = self.msg_queue.get_nowait()
                kind = item[0]
                if kind == 'progress':
                    _, line_no, pct, elapsed, stats = item
                    self.progressbar['value'] = pct if pct else 0
                    self.progress_label.configure(
                        text=f'{line_no:,} lines evaluated  •  {elapsed:.1f}s elapsed  •  '
                             f'{stats.get("loops", 0):,} loops reduced  •  {stats.get("errors", 0):,} anomalies spotted',
                        fg=TEXT)
                    self._log(f'  [INGEST] {line_no:,} lines ({pct:.1f}%) | '
                              f'anomalies: {stats.get("errors", 0)} | collapsed loops: {stats.get("loops", 0)}')
                elif kind == 'done':
                    self.is_running = False
                    self.phase_label.configure(text='✓ PIPELINE RUN COMPLETE', fg=GREEN)
                    self.nodes_label.configure(text='STREAM RESOLVED', fg=GRAY)
                    _, header, stats, out_html, out_err, total_time = item
                    self.progressbar['value'] = 100
                    self.run_btn.configure(state='normal', text='⚡ EXECUTE AI AGENT')
                    rc = header.get('rc')
                    rc_bad = rc is not None and str(rc).strip().lstrip('-').isdigit() and int(rc) != 0

                    rc_str = f"{rc} [! CRITICAL NON-ZERO]" if rc_bad else f"{rc} [HEALTHY]"
                    lines_str = f"{stats['lines']:,}"
                    errors_str = f"{stats['errors']:,}"
                    loops_str = f"{stats['loops']:,} instances ({stats['iter_saved']:,} saved)"
                    time_str = f"{stats['elapsed']:.2f}s"

                    self._log('')
                    self._log('════════════════ AI ANALYSIS MATRIX ════════════════')
                    self._log(f'Target Program      : {header.get("program", "")}')
                    self._log(f'Return Code (RC)    : {rc_str}')
                    self._log(f'Total Lines Read    : {lines_str}')
                    self._log(f'Anomalies Isolated  : {errors_str}')
                    self._log(f'Loop Reduction      : {loops_str}')
                    self._log(f'Total Synthesis Time: {time_str}')
                    self._log('════════════════════════════════════════════════════')
                    self._log('[AI READY] Reports synthesized.')

                    summary = (f'RC={rc}   anomalies={stats["errors"]}   '
                               f'loops reduced={stats["loops"]:,}   synthesis={stats["elapsed"]:.1f}s')
                    self.summary_label.configure(text=summary, fg=(RED if rc_bad or stats['errors'] else GREEN))
                    self.result = (out_html, out_err)
                    if out_html:
                        self.open_report_btn.configure(state='normal')
                    if out_err:
                        self.open_errors_btn.configure(state='normal')
                elif kind == 'error':
                    self.is_running = False
                    _, msg = item
                    self.phase_label.configure(text='✕ PIPELINE ABORTED', fg=RED)
                    self.run_btn.configure(state='normal', text='⚡ EXECUTE AI AGENT')
                    self._log(f'[FATAL ERROR] {msg}')
                    messagebox.showerror('AI Pipeline Error', msg)
        except queue.Empty:
            pass
        self.root.after(100, self._poll_queue)

    def _open_report(self):
        if self.result and self.result[0]:
            webbrowser.open('file://' + os.path.abspath(self.result[0]))

    def _open_errors(self):
        if self.result and self.result[1]:
            path = os.path.abspath(self.result[1])
            try:
                if sys.platform.startswith('win'):
                    os.startfile(path)
                elif sys.platform == 'darwin':
                    os.system(f'open "{path}"')
                else:
                    os.system(f'xdg-open "{path}"')
            except Exception:
                webbrowser.open('file://' + path)


def main():
    root = tk.Tk()
    app = TraceVizApp(root)
    root.mainloop()


if __name__ == '__main__':
    main()

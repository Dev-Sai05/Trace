# ---------------------------------------------------------------------------
# Regexes for line classification
# ---------------------------------------------------------------------------
RE_BATCH   = re.compile(r'^\*\*\*\s*(\d+)\s*\*\*\*$')
RE_HSTART  = re.compile(r'^\*\*\*\s*Start of\s+(\S+)\s+at\s+(.+?)\**$', re.I)
RE_HEND    = re.compile(r'^\*\*\*\s*End\s+of\s+(\S+)\s+at\s+(.+?)(?:-\s*RC\s*=\s*(-?\d+))?\**$', re.I)
RE_DISPLAY = re.compile(r'^-\s*\|(\d{2}:\d{2}:\d{2}\.\d+)\|\s*(.+?)\s*$')
RE_STATUS  = re.compile(r'^([A-Z0-9]+):?\((.+?)\):?\s*(.*)$')
RE_PARA    = re.compile(r'^(?:[A-Z0-9]{1,8}(?:-[A-Z0-9]+)+|[A-Z][0-9]{2,4}[A-Z0-9]?)$')
RE_ERRTXT  = re.compile(r'error|abend|fail(?:ed|ure)?|exception', re.I)
RE_TXN     = re.compile(r'Txn:(\w+)', re.I)

# Database operation identifiers
RE_DB_CALL = re.compile(r'\b(DBIO|DBIODIST|SQLCODE|FETCH|READFIRST|READNEXT|CURSOR|COMMIT|ROLLBACK)\b|ENTRY\s*-\s*FUNCTION\s+(OPEN|READ|FETCH)', re.I)

# C-Support / DBIO Driver Specific Function Scoping
RE_DRIVER_ENTRY = re.compile(r'^([A-Z0-9]+):\(([^)]+)\)\s+ENTRY\s*-\s*FUNCTION\s+(\S+)', re.I)
RE_DRIVER_EXIT  = re.compile(r'^([A-Z0-9]+):\(([^)]+)\)\s+EXIT\s*-\s*FUNCTION\s+(\S+)', re.I)
RE_BINTIME_TAG  = re.compile(r'BINTIME\s*-\s*timestamp routine([^|]+)\|([^|]+)\|\s*(.+)$')

DEFAULT_FLUSH_SIZE   = 4000    
DEFAULT_TAIL_KEEP    = 32      
DEFAULT_MAX_CHILDREN = 4000    
DEFAULT_MAX_PERIOD   = 8       
DEFAULT_MAX_DETAILS  = 20      


def is_error_text(s):
    return bool(RE_ERRTXT.search(s))


def is_db_call(text):
    return bool(RE_DB_CALL.search(text))


class Frame:
    __slots__ = ('name', 'children', 'buffer')

    def __init__(self, name):
        self.name = name
        self.children = []
        self.buffer = []


def shape_of(node):
    t = node['type']
    if t == 'module':
        return 'MOD[%s]{%s}' % (node['name'], '|'.join(shape_of(c) for c in node['children']))
    if t == 'loop':
        return 'LOOP[%d,%d]{%s}' % (node['count'], node['period'], '|'.join(shape_of(c) for c in node['children']))
    if t == 'step':
        return 'S:' + node['name'] + (':ERR' if node.get('error') else '')
    if t == 'status':
        if node['cls'] == 'error':
            return 'ERR:%s:%s' % (node['para'], node['message'])
        return 'T:' + node['para']
    if t == 'info':
        return 'I'
    if t == 'raw':
        return 'RAW:ERR' if node.get('error') else 'RAW'
    return 'X'


def collapse_loops(nodes, max_period, stats):
    shapes = [shape_of(n) for n in nodes]
    out = []
    i, n = 0, len(nodes)
    while i < n:
        best_p, best_count = 0, 0
        max_p = min(max_period, (n - i) // 3)
        for p in range(1, max_p + 1):
            count = 1
            while i + count * p + p <= n:
                if shapes[i + count * p:i + count * p + p] != shapes[i:i + p]:
                    break
                count += 1
            if count >= 3 and count * p > best_count * best_p:
                best_p, best_count = p, count
        if best_count >= 3:
            span = nodes[i:i + best_count * best_p]
            sample = nodes[i:i + best_p]
            msgs = Counter()
            for node in span:
                if node['type'] == 'status':
                    msgs[node['message']] += 1
            out.append({
                'type': 'loop', 'count': best_count, 'period': best_p,
                'children': sample,
                'message_summary': msgs.most_common(5),
            })
            stats['loops'] += 1
            stats['iter_saved'] += (best_count - 1) * best_p
            i += best_count * best_p
        else:
            out.append(nodes[i])
            i += 1
    return out


def flush_frame(frame, max_period, stats, final=False, tail_keep=DEFAULT_TAIL_KEEP):
    if not frame.buffer:
        return
    if final:
        frame.children.extend(collapse_loops(frame.buffer, max_period, stats))
        frame.buffer = []
    else:
        keep = frame.buffer[-tail_keep:]
        rest = frame.buffer[:-tail_keep]
        if rest:
            frame.children.extend(collapse_loops(rest, max_period, stats))
        frame.buffer = keep


def cap_children(node, max_children):
    if node['type'] not in ('module', 'loop', 'root'):
        return node
    kids = node['children']
    for k in kids:
        cap_children(k, max_children)
    if len(kids) > max_children:
        half = max_children // 2
        head, tail = kids[:half], kids[-half:]
        omitted = kids[half:-half]
        omitted_errors = sum(1 for k in _flatten(omitted) if k.get('type') == 'status' and k.get('cls') == 'error')
        placeholder = {
            'type': 'omitted',
            'count': len(omitted),
            'errors': omitted_errors,
        }
        node['children'] = head + [placeholder] + tail
    return node


def _flatten(nodes):
    for n in nodes:
        yield n
        if n['type'] in ('module', 'loop'):
            yield from _flatten(n['children'])


class StreamGraph:
    def __init__(self):
        self.steps = [] 
        self.edges = []
        self.last_idx = None
        self.stack_indices = []

    def add(self, kind, label, depth, error=False, message=None, line_no=0, is_db=False):
        idx = len(self.steps)
        parent_idx = self.stack_indices[-1] if self.stack_indices else None

        node_data = {
            'idx': idx,
            'key': f"step_{idx}",
            'kind': kind,
            'label': label,
            'depth': depth,
            'error': error,
            'is_db': is_db,
            'first_line': line_no,
            'messages': [[message, 1]] if message else [],
            'children_indices': [],
            'parent_idx': parent_idx
        }
        self.steps.append(node_data)
        
        if parent_idx is not None:
            self.steps[parent_idx]['children_indices'].append(idx)

        if kind == 'module':
            self.stack_indices.append(idx)
        elif kind in ('module_end', 'module_unclosed'):
            if self.stack_indices:
                self.stack_indices.pop()

        if self.last_idx is not None:
            is_cross_call = (self.steps[self.last_idx]['depth'] != depth) or (kind == 'module')
            self.edges.append({
                'from': f"step_{self.last_idx}",
                'to': f"step_{idx}",
                'kind': 'ERROR' if error else ('CALL' if is_cross_call else 'NEXT'),
                'count': 1
            })
        self.last_idx = idx


def parse_stream(path, max_period=DEFAULT_MAX_PERIOD, flush_size=DEFAULT_FLUSH_SIZE,
                  tail_keep=DEFAULT_TAIL_KEEP, max_details=DEFAULT_MAX_DETAILS, progress=True):
    root_frame = Frame('ROOT')
    stack = [root_frame]
    header = {'program': None, 'start_at': None, 'end_at': None, 'rc': None, 'trancode': None}
    error_index = []
    stats = {'lines': 0, 'steps': 0, 'status': 0, 'errors': 0, 'modules': 0, 'loops': 0, 'iter_saved': 0, 'db_calls': 0}
    graph = StreamGraph()

    t0 = time.time()
    bytes_read = 0
    file_size = None
    try:
        file_size = os.path.getsize(path)
    except OSError:
        pass

    with open(path, 'r', encoding='utf-8', errors='replace') as f:
        for line_no, raw in enumerate(f, 1):
            bytes_read += len(raw)
            line = raw.strip()
            stats['lines'] = line_no
            if not line:
                continue

            if not header['trancode']:
                m_txn = RE_TXN.search(line)
                if m_txn:
                    header['trancode'] = m_txn.group(1)

            db_flag = is_db_call(line)
            if db_flag:
                stats['db_calls'] += 1

            if progress and line_no % 200000 == 0:
                pct = (bytes_read / file_size * 100) if file_size else 0
                if callable(progress):
                    progress(line_no, pct, time.time() - t0, stats)

            frame = stack[-1]

            if line.startswith('***'):
                m = RE_BATCH.match(line)
                if m:
                    continue
                m = RE_HSTART.match(line)
                if m:
                    header['program'] = header['program'] or m.group(1)
                    header['start_at'] = m.group(2).strip()
                    continue
                m = RE_HEND.match(line)
                if m:
                    header['program'] = header['program'] or m.group(1)
                    header['end_at'] = m.group(2).strip()
                    if m.group(3) is not None:
                        header['rc'] = m.group(3).strip()
                    continue
                continue

            if line.startswith('START OF '):
                name = line[9:].strip()
                stack.append(Frame(name))
                stats['modules'] += 1
                graph.add('module', name, len(stack) - 2, line_no=line_no, is_db=db_flag)
                continue

            if line.startswith('END OF '):
                target_name = line[7:].strip()
                found = False
                for i in range(len(stack) - 1, 0, -1):
                    if stack[i].name == target_name:
                        found = True
                        while len(stack) - 1 > i:
                            unclosed = stack.pop()
                            flush_frame(unclosed, max_period, stats, final=True, tail_keep=tail_keep)
                            stack[-1].buffer.append({'type': 'module', 'name': unclosed.name + ' (unclosed)', 'children': unclosed.children})
                            graph.add('module_unclosed', f"END OF {unclosed.name} (UNCLOSED)", len(stack), error=True, line_no=line_no)
                        finished = stack.pop()
                        flush_frame(finished, max_period, stats, final=True, tail_keep=tail_keep)
                        stack[-1].buffer.append({'type': 'module', 'name': finished.name, 'children': finished.children})
                        graph.add('module_end', f"END OF {finished.name}", len(stack), line_no=line_no)
                        break
                continue

            m_entry = RE_DRIVER_ENTRY.search(line)
            if m_entry:
                mod_name = f"{m_entry.group(1)}:{m_entry.group(3)}"
                stack.append(Frame(mod_name))
                stats['modules'] += 1
                graph.add('module', mod_name, len(stack) - 2, line_no=line_no, is_db=True)
                continue

            m_exit = RE_DRIVER_EXIT.search(line)
            if m_exit:
                mod_name = f"{m_exit.group(1)}:{m_exit.group(3)}"
                for i in range(len(stack) - 1, 0, -1):
                    if stack[i].name == mod_name or stack[i].name.startswith(m_exit.group(1)):
                        while len(stack) - 1 > i:
                            unclosed = stack.pop()
                            graph.add('module_unclosed', f"EXIT {unclosed.name} (UNCLOSED)", len(stack), error=True, line_no=line_no)
                        finished = stack.pop()
                        graph.add('module_end', f"EXIT {finished.name}", len(stack), line_no=line_no, is_db=True)
                        break
                continue

            m_bin = RE_BINTIME_TAG.search(line)
            if m_bin:
                ts_text = m_bin.group(3)
                err = is_error_text(ts_text)
                if err:
                    error_index.append({'line': line_no, 'para': 'C_SUPPORT', 'message': ts_text, 'ts': m_bin.group(2)})
                    stats['errors'] += 1
                graph.add('status', ts_text[:45], len(stack) - 1, error=err, message=ts_text, line_no=line_no, is_db=db_flag)
                continue

            m = RE_STATUS.match(line)
            if m:
                prog, para, msg = m.group(1), m.group(2), m.group(3)
                err = is_error_text(msg)
                if err:
                    error_index.append({'line': line_no, 'para': para, 'message': msg, 'ts': None})
                    stats['errors'] += 1
                graph.add('status', f"{prog}({para})", len(stack) - 1, error=err, message=msg, line_no=line_no, is_db=db_flag)
                continue

            if RE_PARA.match(line):
                frame.buffer.append({'type': 'step', 'name': line})
                stats['steps'] += 1
                graph.add('step', line, len(stack) - 1, line_no=line_no, is_db=db_flag)
                continue

            err = is_error_text(line)
            if err:
                error_index.append({'line': line_no, 'para': 'LOG', 'message': line, 'ts': None})
                stats['errors'] += 1
                graph.add('step', line[:45], len(stack) - 1, error=True, message=line, line_no=line_no)

    while len(stack) > 1:
        finished = stack.pop()
        flush_frame(finished, max_period, stats, final=True, tail_keep=tail_keep)
        stack[-1].buffer.append({'type': 'module', 'name': finished.name + ' (unclosed)', 'children': finished.children})
        graph.add('module_unclosed', f"END OF {finished.name} (UNCLOSED)", len(stack), error=True, line_no=line_no)

    flush_frame(root_frame, max_period, stats, final=True, tail_keep=tail_keep)

    root = {'type': 'root', 'name': 'ROOT', 'children': root_frame.children}
    stats['elapsed'] = time.time() - t0
    stats['bytes'] = bytes_read
    return root, header, error_index, stats, {'nodes': graph.steps, 'edges': graph.edges}


# ---------------------------------------------------------------------------
# Comparative Difference Layout Compiler
# ---------------------------------------------------------------------------
def compute_comparative_diff(graph_before, graph_after, box_w=240, indent_w=70):
    seq_before = [f"{n['kind']}::{n['label']}" for n in graph_before['nodes']]
    seq_after  = [f"{n['kind']}::{n['label']}" for n in graph_after['nodes']]

    matcher = difflib.SequenceMatcher(None, seq_before, seq_after)
    diff_rows = []

    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            for b_idx, a_idx in zip(range(i1, i2), range(j1, j2)):
                diff_rows.append({
                    'status': 'MATCH',
                    'before': graph_before['nodes'][b_idx],
                    'after': graph_after['nodes'][a_idx]
                })
        elif tag == 'replace':
            max_len = max(i2 - i1, j2 - j1)
            for idx in range(max_len):
                node_b = graph_before['nodes'][i1 + idx] if i1 + idx < i2 else None
                node_a = graph_after['nodes'][j1 + idx] if j1 + idx < j2 else None
                diff_rows.append({
                    'status': 'MODIFIED',
                    'before': node_b,
                    'after': node_a
                })
        elif tag == 'delete':
            for b_idx in range(i1, i2):
                diff_rows.append({
                    'status': 'REMOVED',
                    'before': graph_before['nodes'][b_idx],
                    'after': None
                })
        elif tag == 'insert':
            for a_idx in range(j1, j2):
                diff_rows.append({
                    'status': 'ADDED',
                    'before': None,
                    'after': graph_after['nodes'][a_idx]
                })

    for row in diff_rows:
        if row['before']:
            row['before']['x'] = row['before']['depth'] * indent_w
            row['before']['diff_status'] = row['status']
        if row['after']:
            row['after']['x'] = row['after']['depth'] * indent_w
            row['after']['diff_status'] = row['status']

    max_b_x = max((r['before']['x'] for r in diff_rows if r['before']), default=0) + box_w + 60
    max_a_x = max((r['after']['x'] for r in diff_rows if r['after']), default=0) + box_w + 60

    return diff_rows, max_b_x, max_a_x



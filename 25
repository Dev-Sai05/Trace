<script>
const DIFF_DATA = __DIFF_DATA_JSON__;
const BOX_W = 230, BOX_H = 46, OFF_X = 40, OFF_Y = 30, STEP_Y = 72;

let currentFilter = 'all';
const collapsedModules = new Set();
let activeDiffIndices = [];
let currentDiffPointer = -1;

function esc(s){return (s+'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}

// Bind CR Labels
const crBefore = DIFF_DATA.cr_before || 'CR-BASE';
const crAfter  = DIFF_DATA.cr_after  || 'CR-TARGET';
const trancode = DIFF_DATA.trancode  || 'TRANCODE';

document.getElementById('banner-trancode').textContent = trancode;
document.getElementById('sidebar-cr-before').textContent = crBefore;
document.getElementById('sidebar-cr-after').textContent = crAfter;
document.getElementById('banner-cr-b').textContent = crBefore;
document.getElementById('banner-cr-a').textContent = crAfter;
document.getElementById('col-title-b').textContent = `BEFORE CHANGE [${crBefore}]`;
document.getElementById('col-title-a').textContent = `AFTER CHANGE [${crAfter}]`;

// Summary Metrics
const sb = DIFF_DATA.stats_before;
const sa = DIFF_DATA.stats_after;

document.getElementById('m-b-steps').textContent = sb.steps.toLocaleString();
document.getElementById('m-a-steps').textContent = sa.steps.toLocaleString();
const dSteps = sa.steps - sb.steps;
document.getElementById('m-d-steps').textContent = (dSteps >= 0 ? '+' : '') + dSteps.toLocaleString();
document.getElementById('m-d-steps').className = 'val ' + (dSteps > 0 ? 'delta-pos' : (dSteps < 0 ? 'delta-neg' : ''));

document.getElementById('m-b-db').textContent = sb.db_calls.toLocaleString();
document.getElementById('m-a-db').textContent = sa.db_calls.toLocaleString();
const dDB = sa.db_calls - sb.db_calls;
document.getElementById('m-d-db').textContent = (dDB >= 0 ? '+' : '') + dDB.toLocaleString();
document.getElementById('m-d-db').className = 'val ' + (dDB > 0 ? 'delta-pos' : (dDB < 0 ? 'delta-neg' : ''));

document.getElementById('m-b-mods').textContent = sb.modules.toLocaleString();
document.getElementById('m-a-mods').textContent = sa.modules.toLocaleString();
const dMods = sa.modules - sb.modules;
document.getElementById('m-d-mods').textContent = (dMods >= 0 ? '+' : '') + dMods.toLocaleString();
document.getElementById('m-d-mods').className = 'val ' + (dMods > 0 ? 'delta-pos' : (dMods < 0 ? 'delta-neg' : ''));

const diffsOnly = DIFF_DATA.diff_rows.filter(r => r.status !== 'MATCH').length;
document.getElementById('m-diff-count').textContent = `${diffsOnly} Steps Changed`;

function setFilter(f){
  currentFilter = f;
  document.querySelectorAll('.seg-btn').forEach(b => {
    b.classList.remove('active');
    b.classList.remove('active-diff');
  });
  const btn = document.getElementById('f-' + f);
  if(btn) {
    if(f === 'diff') btn.classList.add('active-diff');
    else btn.classList.add('active');
  }
  renderDiagrams();
}

function toggleAllModules(collapse){
  DIFF_DATA.diff_rows.forEach(r => {
    ['before', 'after'].forEach(side => {
      const node = r[side];
      if(node && node.kind === 'module') {
        const key = `${side}_${node.key}`;
        if(collapse) collapsedModules.add(key);
        else collapsedModules.delete(key);
      }
    });
  });
  renderDiagrams();
}

function isNodeVisible(node, side){
  if(!node) return false;
  
  let pIdx = node.parent_idx;
  const nodes = (side === 'before') ? DIFF_DATA.diff_rows.map(r=>r.before).filter(Boolean) : DIFF_DATA.diff_rows.map(r=>r.after).filter(Boolean);
  while(pIdx !== null && pIdx !== undefined){
    const parent = nodes.find(n => n.idx === pIdx);
    if(parent){
      if(collapsedModules.has(`${side}_${parent.key}`)) return false;
      pIdx = parent.parent_idx;
    } else {
      break;
    }
  }

  if(currentFilter === 'diff') return true; 
  if(currentFilter === 'db') return node.is_db;
  if(currentFilter === 'para') return node.kind === 'step';
  if(currentFilter === 'module') return node.kind === 'module' || node.kind === 'module_end' || node.kind === 'module_unclosed';
  return true;
}

function inspect(node, side){
  const el = document.getElementById('drawerBody');
  if(!node){ el.textContent = 'None'; return; }
  const activeCr = (side === 'before') ? crBefore : crAfter;
  let msg = `[CR: ${activeCr}] Line: ${node.first_line} | Type: ${node.kind.toUpperCase()} | Label: ${node.label} | Depth: Lvl ${node.depth}\n`;
  if(node.diff_status && node.diff_status !== 'MATCH') {
    msg += `Difference Status: ${node.diff_status} (RED)\n`;
  }
  if(node.is_db) msg += `Database Call: YES\n`;
  if(node.messages && node.messages.length) {
    msg += `Context: ${node.messages.map(m=>m[0]).join('\n')}\n`;
  }
  el.textContent = msg;
}

function buildBox(node, side, status, yPos, diffIndex){
  const box = document.createElement('div');
  let typeCls = 'is-para';
  let badge = '<span class="badge-tag badge-para">PARA</span>';

  if(node.is_db){
    typeCls = 'is-db';
    badge = '<span class="badge-tag badge-db">DB</span>';
  } else if(node.kind === 'module'){
    typeCls = 'is-module';
    badge = '<span class="badge-tag badge-call">CALL</span>';
  }

  let diffCls = '';
  if(status !== 'MATCH'){
    diffCls = 'diff-highlight';
    if(status === 'REMOVED') {
      diffCls += ' diff-removed';
      badge = '<span class="badge-tag badge-diff">REMOVED</span>';
    } else if(status === 'ADDED') {
      badge = '<span class="badge-tag badge-diff">ADDED</span>';
    } else if(status === 'MODIFIED') {
      badge = '<span class="badge-tag badge-diff">MODIFIED</span>';
    }
  }

  box.className = `flowbox ${typeCls} ${diffCls}`;
  box.style.left = (node.x + OFF_X) + 'px';
  box.style.top = (yPos + OFF_Y) + 'px';
  box.style.width = BOX_W + 'px';
  box.style.height = BOX_H + 'px';
  box.id = `box-${side}-${node.key}`;

  if(status !== 'MATCH' && diffIndex !== undefined){
    box.setAttribute('data-diff-index', diffIndex);
  }

  let collapseIcon = '';
  if(node.kind === 'module'){
    const isCol = collapsedModules.has(`${side}_${node.key}`);
    collapseIcon = `<span style="font-size:9px;margin-right:4px;">${isCol ? '▸' : '▾'}</span>`;
  }

  box.innerHTML = `${badge}${collapseIcon}<span class="lbl">${esc(node.label)}</span>`;

  box.addEventListener('mouseenter', ()=> inspect(node, side));
  box.addEventListener('click', (e)=>{
    if(node.kind === 'module'){
      const key = `${side}_${node.key}`;
      if(collapsedModules.has(key)) collapsedModules.delete(key);
      else collapsedModules.add(key);
      renderDiagrams();
    } else {
      inspect(node, side);
    }
  });

  return box;
}

function renderDiagrams(){
  const cBefore = document.getElementById('canvasBefore');
  const cAfter = document.getElementById('canvasAfter');

  cBefore.querySelectorAll('.flowbox').forEach(b => b.remove());
  cAfter.querySelectorAll('.flowbox').forEach(b => b.remove());

  const rows = DIFF_DATA.diff_rows;
  let bNodes = [], aNodes = [];
  let renderedCount = 0;
  activeDiffIndices = [];

  rows.forEach((r) => {
    if(currentFilter === 'diff' && r.status === 'MATCH') return;

    const bShow = isNodeVisible(r.before, 'before');
    const aShow = isNodeVisible(r.after, 'after');

    if(!bShow && !aShow) return;

    const yPos = renderedCount * STEP_Y;
    let diffIdx = undefined;

    if(r.status !== 'MATCH'){
      diffIdx = activeDiffIndices.length;
      activeDiffIndices.push({
        index: diffIdx,
        y: yPos + OFF_Y,
        before: r.before,
        after: r.after
      });
    }

    if(bShow){
      r.before._renderedY = yPos;
      cBefore.appendChild(buildBox(r.before, 'before', r.status, yPos, diffIdx));
      bNodes.push(r.before);
    }

    if(aShow){
      r.after._renderedY = yPos;
      cAfter.appendChild(buildBox(r.after, 'after', r.status, yPos, diffIdx));
      aNodes.push(r.after);
    }

    renderedCount++;
  });

  const totalH = Math.max(renderedCount * STEP_Y + 120, 600);
  cBefore.style.width = DIFF_DATA.width_before + 'px';
  cBefore.style.height = totalH + 'px';
  cAfter.style.width = DIFF_DATA.width_after + 'px';
  cAfter.style.height = totalH + 'px';

  document.getElementById('title-b-count').textContent = `(${bNodes.length} steps)`;
  document.getElementById('title-a-count').textContent = `(${aNodes.length} steps)`;

  drawLines(bNodes, 'svgBefore', DIFF_DATA.width_before, totalH);
  drawLines(aNodes, 'svgAfter', DIFF_DATA.width_after, totalH);

  updateDiffNavUI();
}

function drawLines(nodes, svgId, width, totalH){
  const svg = document.getElementById(svgId);
  svg.innerHTML = '';
  svg.setAttribute('width', width);
  svg.setAttribute('height', totalH);
  const NS = 'http://www.w3.org/2000/svg';
  
  const defs = document.createElementNS(NS, 'defs');
  defs.innerHTML = `<marker id="arr-norm-${svgId}" markerWidth="8" markerHeight="8" refX="5" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#5b7a63"/></marker>` +
                   `<marker id="arr-diff-${svgId}" markerWidth="8" markerHeight="8" refX="5" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#ff4d4d"/></marker>`;
  svg.appendChild(defs);

  for(let i=0; i<nodes.length-1; i++){
    const a = nodes[i];
    const b = nodes[i+1];
    const isDiff = (a.diff_status && a.diff_status !== 'MATCH') || (b.diff_status && b.diff_status !== 'MATCH');
    const color = isDiff ? '#ff4d4d' : '#5b7a63';
    const marker = isDiff ? `url(#arr-diff-${svgId})` : `url(#arr-norm-${svgId})`;

    const path = document.createElementNS(NS, 'path');
    const x1 = a.x + OFF_X + BOX_W/2;
    const y1 = a._renderedY + OFF_Y + BOX_H;
    const x2 = b.x + OFF_X + BOX_W/2;
    const y2 = b._renderedY + OFF_Y;

    let d = `M ${x1} ${y1} V ${(y1+y2)/2} H ${x2} V ${y2}`;
    path.setAttribute('d', d);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', color);
    path.setAttribute('stroke-width', isDiff ? '2' : '1.5');
    path.setAttribute('marker-end', marker);
    svg.appendChild(path);
  }
}

// Diff Navigator Functions
function updateDiffNavUI(){
  const label = document.getElementById('diffNavLabel');
  const total = activeDiffIndices.length;
  if(total === 0){
    label.textContent = '0 / 0';
    currentDiffPointer = -1;
  } else {
    const displayIdx = currentDiffPointer >= 0 ? (currentDiffPointer + 1) : 0;
    label.textContent = `${displayIdx} / ${total}`;
  }
}

function jumpToDiff(index){
  if(activeDiffIndices.length === 0) return;
  if(index < 0) index = 0;
  if(index >= activeDiffIndices.length) index = activeDiffIndices.length - 1;
  currentDiffPointer = index;

  document.querySelectorAll('.diff-spotlight').forEach(el => el.classList.remove('diff-spotlight'));

  const target = activeDiffIndices[currentDiffPointer];
  const wB = document.getElementById('wrapBefore');
  const wA = document.getElementById('wrapAfter');
  
  const viewH = wB.clientHeight;
  const scrollTarget = Math.max(0, target.y - viewH / 2 + BOX_H / 2);

  syncLock = true;
  wB.scrollTo({ top: scrollTarget, behavior: 'smooth' });
  wA.scrollTo({ top: scrollTarget, behavior: 'smooth' });
  setTimeout(() => { syncLock = false; }, 350);

  if(target.before){
    const elB = document.getElementById(`box-before-${target.before.key}`);
    if(elB) elB.classList.add('diff-spotlight');
  }
  if(target.after){
    const elA = document.getElementById(`box-after-${target.after.key}`);
    if(elA) elA.classList.add('diff-spotlight');
  }

  if(target.after) inspect(target.after, 'after');
  else if(target.before) inspect(target.before, 'before');

  updateDiffNavUI();
}

function nextDiff(){
  if(activeDiffIndices.length === 0) return;
  let nextIdx = currentDiffPointer + 1;
  if(nextIdx >= activeDiffIndices.length) nextIdx = 0;
  jumpToDiff(nextIdx);
}

function prevDiff(){
  if(activeDiffIndices.length === 0) return;
  let prevIdx = currentDiffPointer - 1;
  if(prevIdx < 0) prevIdx = activeDiffIndices.length - 1;
  jumpToDiff(prevIdx);
}

// Shortcuts
window.addEventListener('keydown', (e)=>{
  if(e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
  if(e.key === 'j' || e.key === 'J' || e.key === 'n' || e.key === 'N'){
    e.preventDefault();
    nextDiff();
  } else if(e.key === 'k' || e.key === 'K' || e.key === 'p' || e.key === 'P'){
    e.preventDefault();
    prevDiff();
  }
});

// Initial Render
renderDiagrams();

// Synchronized Scrolling
const wB = document.getElementById('wrapBefore');
const wA = document.getElementById('wrapAfter');
let syncLock = false;

wB.addEventListener('scroll', ()=>{
  if(syncLock) return;
  syncLock = true;
  wA.scrollTop = wB.scrollTop;
  syncLock = false;
});

wA.addEventListener('scroll', ()=>{
  if(syncLock) return;
  syncLock = true;
  wB.scrollTop = wA.scrollTop;
  syncLock = false;
});
</script>
</body></html>
'''


def render_diff_html(diff_rows, stats_b, stats_a, out_path, w_b, w_a, cr_before, cr_after, trancode):
    data = {
        'diff_rows': diff_rows,
        'stats_before': stats_b,
        'stats_after': stats_a,
        'width_before': w_b,
        'width_after': w_a,
        'cr_before': cr_before,
        'cr_after': cr_after,
        'trancode': trancode
    }
    payload = json.dumps(data, separators=(',', ':'))
    out = (HTML_DIFF_TEMPLATE.replace('__DIFF_DATA_JSON__', payload)
                             .replace('__TRANCODE__', html.escape(str(trancode)))
                             .replace('__CR_BEFORE__', html.escape(str(cr_before)))
                             .replace('__CR_AFTER__', html.escape(str(cr_after))))
    with open(out_path, 'w', encoding='utf-8') as f:
        f.write(out)


def compare_traces(path_before, path_after, out_path=None, cr_before="CR-BASE", cr_after="CR-TARGET"):
    """Core comparative function with standardized custom file naming."""
    _, header_b, _, stats_b, graph_b = parse_stream(path_before, progress=False)
    _, header_a, _, stats_a, graph_a = parse_stream(path_after, progress=False)

    diff_rows, w_b, w_a = compute_comparative_diff(graph_b, graph_a)

    trancode = header_a.get('trancode') or header_b.get('trancode')
    if not trancode:
        base_name = os.path.basename(path_after)
        m = re.search(r'(\d{5,8})', base_name)
        trancode = m.group(1) if m else "TRANCODE"

    safe_cr_b = re.sub(r'[^\w.-]', '_', str(cr_before).strip())
    safe_cr_a = re.sub(r'[^\w.-]', '_', str(cr_after).strip())
    safe_txn  = re.sub(r'[^\w.-]', '_', str(trancode).strip())

    if not out_path:
        out_dir = os.path.dirname(os.path.abspath(path_after))
        file_name = f"{safe_txn} - {safe_cr_b} to {safe_cr_a}.html"
        out_file = os.path.join(out_dir, file_name)
    else:
        out_file = out_path

    render_diff_html(diff_rows, stats_b, stats_a, out_file, w_b, w_a, cr_before, cr_after, trancode)
    return out_file, stats_b, stats_a, trancode


def main():
    ap = argparse.ArgumentParser(description='TRANDIFF - Comparative Trace Flow Analyzer')
    ap.add_argument('input', help='Before log or primary trace log')
    ap.add_argument('--after', help='After change trace log for differential evaluation', default=None)
    ap.add_argument('--cr-before', help='Change Request number for before log', default='CR-BASE')
    ap.add_argument('--cr-after', help='Change Request number for after log', default='CR-TARGET')
    ap.add_argument('-o', '--output', help='Output HTML report path', default=None)
    args = ap.parse_args()

    if args.after:
        out_html, sb, sa, txn = compare_traces(args.input, args.after, args.output, args.cr_before, args.cr_after)
        print(f"Comparison report generated: {out_html}")
        print(f"Transaction: {txn}")
        print(f"CRs: {args.cr_before} -> {args.cr_after}")
        print(f"Paragraphs: Before={sb['steps']} | After={sa['steps']} (Delta={sa['steps']-sb['steps']})")
        print(f"DB Calls:   Before={sb['db_calls']} | After={sa['db_calls']} (Delta={sa['db_calls']-sb['db_calls']})")
    else:
        print("Run with --after <after_log_path> to compare traces.")


if __name__ == '__main__':
    main()
